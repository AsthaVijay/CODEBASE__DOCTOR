# Copy to .env.local. Enter the key locally, never in chat or source control.
BOB_API_KEY=
# Or point to an existing key file so the secret need not be copied here:
# BOB_API_KEY_FILE=/absolute/path/to/bob-key.txt
# auto mode uses IBM Bob when a key is present, otherwise the local demo adapter.
# BOB_PROVIDER=bob explicitly enables the live provider; a valid API key is required.
# BOB_PROVIDER=demo forces the zero-credit deterministic workflow.
BOB_PROVIDER=auto
BOB_MAX_COST=0.5
# Set only if bob is not on the server's PATH:
# BOB_BIN=/absolute/path/to/bob
# General API keys also require BOB_TEAM_ID. Prefer an Inference API key.
# BOB_TEAM_ID=
